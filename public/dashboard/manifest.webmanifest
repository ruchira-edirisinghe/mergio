{
  "id": "/dashboard",
  "name": "Mergio",
  "short_name": "Mergio",
  "description": "Control panel for Mergio: every live chat in one OBS overlay.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b0b10",
  "theme_color": "#0b0b10",
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "/shared/app-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/shared/app-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/shared/app-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
